{
  "name": "rert-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Research and educational prototype for evidence-linked reirradiation OAR dose review (fictional cases only).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:evidence": "node scripts/verify-quotes.mjs evidence/extraction .fulltext-cache",
    "build:evidence": "node scripts/build-evidence.mjs",
    "coverage": "node scripts/coverage-report.mjs",
    "fetch:sources": "node scripts/fetch-sources.mjs .fulltext-cache"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
